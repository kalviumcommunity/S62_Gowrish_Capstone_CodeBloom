# Server Port
PORT=8080

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/codebloom?retryWrites=true&w=majority

# JWT Authentication Secret
SECRET=your_jwt_secret_key_here

# Google Gemini API Key for AI Course & Quiz Generation (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key for Video Tutorials (https://console.cloud.google.com/)
YOUTUBE_API_KEY=your_youtube_api_key_here
